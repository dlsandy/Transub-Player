<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransubPlayer.Desktop.FavoritesWindow"
        Title="收藏"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="打开" Click="OnOpen"/>
      <Button Content="关闭" Click="OnClose"/>
    </StackPanel>
    <ListBox x:Name="List" DoubleTapped="OnDoubleTap"/>
  </DockPanel>
</Window>
