<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransubPlayer.Desktop.LanShareWindow"
        Title="局域网共享"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ToggleButton" Content="启动" Click="OnToggle"/>
      <Button Content="关闭" Click="OnClose"/>
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock Text="手机扫码播放，桌面负责识别/翻译" Opacity="0.8"/>
      <TextBlock x:Name="StatusBlock" TextWrapping="Wrap"/>
      <TextBox x:Name="UrlBox" IsReadOnly="True"/>
      <Image x:Name="QrImage" Width="180" Height="180" HorizontalAlignment="Left"/>
    </StackPanel>
  </DockPanel>
</Window>
