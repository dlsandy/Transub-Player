<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransubPlayer.Desktop.OpenUrlWindow"
        Title="打开 URL"
        Width="480" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="打开" Click="OnOk"/>
      <Button Content="取消" Click="OnCancel"/>
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Text="流媒体 / 直播 URL"/>
      <TextBox x:Name="UrlBox" PlaceholderText="https://…"/>
    </StackPanel>
  </DockPanel>
</Window>
