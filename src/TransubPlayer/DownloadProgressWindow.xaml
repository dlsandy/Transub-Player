<Window x:Class="TransubPlayer.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        Title="{loc:Loc DownloadProgress.Title}"
        Width="520" Height="240"
        MinWidth="440" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="{loc:Loc DownloadProgress.Cancel}"
                    Click="Cancel_Click" Padding="14,6" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"
                       Text="{loc:Loc DownloadProgress.Starting}"/>
            <Grid Margin="0,0,0,6">
                <ProgressBar x:Name="ProgressBar" Height="10" IsIndeterminate="True" Maximum="100"/>
                <TextBlock x:Name="PercentText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SizeText" Grid.Column="0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="SpeedText" Grid.Column="1" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
