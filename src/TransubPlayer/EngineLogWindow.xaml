<Window x:Class="TransubPlayer.EngineLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        Title="{loc:Loc EngineLog.Title}"
        Width="720" Height="480"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Loc EngineLog.OpenFolder}" Click="OpenFolder_Click" Margin="0,0,8,0" Padding="12,6"/>
            <Button Content="{loc:Loc EngineLog.Clear}" Click="Clear_Click" Margin="0,0,8,0" Padding="12,6"/>
            <Button Content="{loc:Loc EngineLog.Refresh}" Click="Refresh_Click" Margin="0,0,8,0" Padding="12,6"/>
            <Button Content="{loc:Loc Common.Close}" Click="Close_Click" Padding="12,6" IsDefault="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc EngineLog.Hint}" Margin="0,0,0,8"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Background="#0c0c0c">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource TextBrush}" FontFamily="Consolas, Cascadia Mono, monospace"
                     FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Padding="8"/>
        </Border>
    </DockPanel>
</Window>
