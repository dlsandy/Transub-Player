<Window x:Class="TransubPlayer.FavoriteNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        Title="{loc:Loc FavoriteName.Title}"
        Width="480" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc FavoriteName.Save}" Click="Save_Click" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" IsDefault="True"/>
            <Button Content="{loc:Loc Common.Cancel}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{loc:Loc FavoriteName.NameLabel}" FontSize="14" Margin="0,0,0,8"/>
            <TextBox x:Name="NameBox" MinHeight="32" Padding="8,6" FontSize="14"
                     VerticalContentAlignment="Center"/>
            <TextBlock x:Name="UrlHint" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
