<Window x:Class="TransubPlayer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        SizeToContent="WidthAndHeight"
        MinWidth="420" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleLabel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="BodyLabel" TextWrapping="Wrap" FontSize="13" LineHeight="22"
                       Foreground="{StaticResource TextBrush}" MaxWidth="500"/>
            <Button Content="{loc:Loc Common.Close}" HorizontalAlignment="Right" Margin="0,16,0,0"
                    Padding="16,6" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
