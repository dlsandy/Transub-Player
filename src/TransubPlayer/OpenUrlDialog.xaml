<Window x:Class="TransubPlayer.OpenUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        Title="{loc:Loc OpenUrl.Title}"
        Width="560" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc OpenUrl.Open}" Click="Open_Click" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" IsDefault="True"/>
            <Button Content="{loc:Loc Common.Cancel}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{loc:Loc OpenUrl.Prompt}" FontSize="14" Margin="0,0,0,8"/>
            <TextBox x:Name="UrlBox" MinHeight="32" Padding="8,6" FontSize="14"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="{loc:Loc OpenUrl.Hint}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
