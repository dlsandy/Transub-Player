                                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Style="{StaticResource FieldCell}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.AsrBackend.Label}"/>
                                            <ComboBox x:Name="AsrBackendBox"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldCell}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.Advanced.HfMirror}"/>
                                            <TextBox x:Name="HfBox"/>
