                                              SelectionChanged="TranslateModelBox_SelectionChanged"/>
                                    <TextBlock x:Name="TranslateModelHintLabel" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MtCardStatusLabel" Style="{StaticResource Hint}"/>
