                                                Content="{loc:Loc Common.Browse}"
                                                Margin="8,0,0,0" MinWidth="72" Click="BrowseGlossary_Click"/>
                                        <TextBox x:Name="GlossaryPathBox"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <StackPanel Style="{StaticResource FieldCell}">
