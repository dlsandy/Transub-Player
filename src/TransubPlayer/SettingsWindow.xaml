                                                Click="OpenAdvancedLlm_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="DeleteTranslateButton"
                                                Content="{loc:Loc Settings.Models.DeleteTranslate}"
                                                Click="DeleteGguf_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                <Button x:Name="ModelsCancelPackButton" DockPanel.Dock="Right"
                                        Content="{loc:Loc Settings.Advanced.Cancel}"
                                        Click="CancelPack_Click" IsEnabled="False" Margin="8,0,0,0"
                                        VerticalAlignment="Top"/>
                                <TextBlock x:Name="PresetStatusLabel" Style="{StaticResource Hint}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <TextBlock x:Name="ModelsStatusLabel" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc Settings.Tab.Association}" Style="{StaticResource SettingsNav}">
                    <ScrollViewer Style="{StaticResource PageScroll}">
