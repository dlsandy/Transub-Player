                                        <TextBlock x:Name="HideDelayLabel" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.DefaultVolume}"/>
