                                                Click="AssociationSelectAll_Click"/>
                                        <Button Content="{loc:Loc Settings.Association.SelectNone}" Margin="0,0,8,8"
                                                Click="AssociationSelectNone_Click"/>
                                        <Button Style="{StaticResource AccentButton}" Content="{loc:Loc Settings.Association.Apply}"
                                                Margin="0,0,8,8" Click="AssociationApply_Click"/>
                                    </WrapPanel>
                                    <ItemsControl x:Name="AssociationGroups"/>
                                    <TextBlock x:Name="AssociationStatusLabel" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc Settings.Tab.Advanced}" Style="{StaticResource SettingsNav}">
                    <ScrollViewer Style="{StaticResource PageScroll}">
