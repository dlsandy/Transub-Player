                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldCell}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.SubBorder}"/>
                                            <DockPanel>
                                                <TextBlock x:Name="SubBorderLabel" DockPanel.Dock="Right" Style="{StaticResource ValueLabel}"/>
                                                <Slider x:Name="SubBorderSlider" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                            </DockPanel>
                                        </StackPanel>
