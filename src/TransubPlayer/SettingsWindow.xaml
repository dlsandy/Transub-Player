                                    </DockPanel>
                                    <UniformGrid Columns="3">
                                        <StackPanel Style="{StaticResource FieldCell}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.DefaultSpeed}"/>
                                            <ComboBox x:Name="DefaultSpeedBox"/>
