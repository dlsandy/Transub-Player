                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.SeekLarge}"/>
                                            <ComboBox x:Name="SeekLargeBox"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldCell}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.HwDec}"/>
                                            <ComboBox x:Name="HwDecBox"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldCell}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.VideoFit}"/>
                                            <ComboBox x:Name="VideoFitBox"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{loc:Loc Settings.Playback.AdvancedHint}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc Settings.Tab.Subtitle}" Style="{StaticResource SettingsNav}">
