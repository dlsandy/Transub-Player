                                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Settings.AddSameFolderToPlaylist.Hint}"/>
                                    <CheckBox x:Name="PrefetchPlaylistBox" Content="{loc:Loc Settings.PrefetchPlaylist}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="PrefetchPlaylistHint" Style="{StaticResource Hint}"
                                               Text="{loc:Loc Settings.PrefetchPlaylist.Hint}"/>
                                    <CheckBox x:Name="RememberPosBox" Content="{loc:Loc Settings.RememberPos}" Margin="0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Settings.Section.Fullscreen}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="FullscreenQuietOsdBox" Content="{loc:Loc Settings.FullscreenQuietOsd}"/>
