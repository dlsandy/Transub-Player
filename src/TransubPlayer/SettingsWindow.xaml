                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.Advanced.UpdateSource}"/>
                                            <ComboBox x:Name="UpdateSourceBox"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="CheckUpdatesOnStartupBox" Margin="0,4,0,8"
                                              Content="{loc:Loc Settings.Advanced.CheckUpdatesOnStartup}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                               Text="{loc:Loc Settings.Advanced.UpdateHint}"/>
                                    <TextBlock x:Name="EngineCapsLabel" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Settings.Advanced.ModelsTabHint}" Margin="0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.Advanced.MtModels}"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="{loc:Loc Settings.Advanced.InstallLlama}" Click="InstallLlama_Click" Margin="0,0,8,8"/>
                                        <Button Content="{loc:Loc Settings.Presets.Manual}"
                                                Click="ManualInstallLlama_Click" Margin="0,0,8,8"/>
                                        <Button x:Name="CancelPackButton" Content="{loc:Loc Settings.Advanced.Cancel}" Click="CancelPack_Click" IsEnabled="False" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="PackStatusLabel" Style="{StaticResource Hint}" Margin="0"
                                               Text="{loc:Loc Settings.Advanced.PackHint}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
