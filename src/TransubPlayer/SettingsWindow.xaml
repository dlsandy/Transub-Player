                                        <TextBlock x:Name="SubPreviewSample" Text="{loc:Loc Settings.Subtitle.PreviewSample}"
                                                   Foreground="#F9FAFB"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{loc:Loc Settings.Subtitle.PreviewHint}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

