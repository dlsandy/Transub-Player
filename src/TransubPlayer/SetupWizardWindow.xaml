<Window x:Class="TransubPlayer.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{loc:Loc Wizard.Title}"
        Width="680" Height="720"
        MinWidth="580" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F4F6"
        Foreground="#111827"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="14"
        FocusVisualStyle="{x:Null}">
    <Window.Resources>
        <Color x:Key="BgColor">#F3F4F6</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="LineColor">#E5E7EB</Color>
        <Color x:Key="TextColor">#111827</Color>
        <Color x:Key="MutedColor">#6B7280</Color>
        <Color x:Key="AccentColor">#2563EB</Color>
        <Color x:Key="AccentHoverColor">#1D4ED8</Color>
        <Color x:Key="NavHoverColor">#EEF2FF</Color>
        <Color x:Key="NavSelectedColor">#DBEAFE</Color>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentInkBrush" Color="White"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}"/>
        <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}"/>
        <SolidColorBrush x:Key="FieldBgBrush" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <sys:Double x:Key="FieldHeight">36</sys:Double>
        <Thickness x:Key="FieldPadding">10,0</Thickness>

        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
            <Setter Property="MinHeight" Value="{StaticResource FieldHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="MaxDropDownHeight" Value="360"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="7">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Width="30" Background="Transparent">
                                                    <Path Data="M0,0 L7,0 L3.5,4 Z"
                                                          Fill="#9CA3AF"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="Transparent"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <DockPanel IsHitTestVisible="False">
                                <Border DockPanel.Dock="Right" Width="30"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" Margin="2,0,0,0"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="FieldCell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,14"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="22,18,18,12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="StepPill" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Height="40"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                        <Image Source="pack://application:,,,/Assets/app.png" Width="18" Height="18" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{loc:Loc Wizard.Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButton}" Click="Close_Click"
                            ToolTip="{loc:Loc Common.Close}">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="10" Height="10"
                              Data="M1,1 L9,9 M9,1 L1,9" Stretch="None"/>
                    </Button>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource SurfaceBrush}">
                <DockPanel Margin="22,12,22,14" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BackButton" Content="{loc:Loc Wizard.Back}" Click="Back_Click"
                                Margin="0,0,8,0" MinWidth="80" Visibility="Collapsed"/>
                        <Button x:Name="NextButton" Style="{StaticResource AccentButton}"
                                Content="{loc:Loc Wizard.Next}" Click="Next_Click" MinWidth="110"
                                IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Wizard.Subtitle}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                                           Text="{loc:Loc Wizard.Preferences.Section.Language}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0"
                                           Text="{loc:Loc Wizard.Preferences.Language.Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="UiLanguageBox" DockPanel.Dock="Right"
                                      Width="200" VerticalAlignment="Center"
                                      SelectionChanged="UiLanguageBox_SelectionChanged"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border x:Name="StepPrefsPill" Style="{StaticResource StepPill}">
                            <TextBlock x:Name="StepPrefsLabel" Text="{loc:Loc Wizard.Step.Preferences}"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Border x:Name="StepInstallPill" Style="{StaticResource StepPill}">
                            <TextBlock x:Name="StepInstallLabel" Text="{loc:Loc Wizard.Step.Install}"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <Border x:Name="StepDonePill" Style="{StaticResource StepPill}">
                            <TextBlock x:Name="StepDoneLabel" Text="{loc:Loc Wizard.Step.Done}"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Step 0: preferences -->
                    <StackPanel x:Name="PrefsPanel">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Wizard.Preferences.Section.Playback}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Wizard.Preferences.Intro}"/>
                                <CheckBox x:Name="AutoPlayBox" Content="{loc:Loc Wizard.Preferences.AutoPlay}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                                <CheckBox x:Name="AutoPreviewBox" Content="{loc:Loc Wizard.Preferences.AutoPreview}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                                <CheckBox x:Name="PreferExternalBox" Content="{loc:Loc Wizard.Preferences.PreferExternal}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                                <CheckBox x:Name="SubtitleCatBox" Content="{loc:Loc Wizard.Preferences.OnlineSubtitles}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Wizard.Preferences.Section.Translate}"/>
                                <CheckBox x:Name="TranslateBox" Content="{loc:Loc Wizard.Preferences.Translate}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                                <StackPanel x:Name="TranslateTargetPanel" Style="{StaticResource FieldCell}"
                                            MaxWidth="320" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.TranslateTarget}"/>
                                    <ComboBox x:Name="TranslateTargetBox" SelectionChanged="Pref_Changed"/>
                                </StackPanel>
                                <CheckBox x:Name="PlayImmediatelyBox" Content="{loc:Loc Wizard.Preferences.PlayImmediately}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                                <CheckBox x:Name="WaitFirstZhBox" Content="{loc:Loc Wizard.Preferences.WaitFirstZh}"
                                          Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                                <StackPanel x:Name="WaitZhMinutesPanel" Style="{StaticResource FieldCell}"
                                            MaxWidth="280" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.WaitZhMinutes}"/>
                                    <ComboBox x:Name="WaitZhMinutesBox" SelectionChanged="Pref_Changed"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Wizard.Preferences.WaitHint}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Wizard.Preferences.Section.Paths}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Wizard.Preferences.Paths.Hint}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.Paths.ModelsDir}"/>
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="{loc:Loc Common.Browse}"
                                            Margin="8,0,0,0" MinWidth="72" Click="BrowseModelsPath_Click"/>
                                    <TextBox x:Name="ModelsPathBox" Height="{StaticResource FieldHeight}"
                                             Padding="{StaticResource FieldPadding}" VerticalContentAlignment="Center"
                                             Background="{StaticResource FieldBgBrush}"
                                             BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Settings.Paths.RuntimeDir}"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="{loc:Loc Common.Browse}"
                                            Margin="8,0,0,0" MinWidth="72" Click="BrowseAdvancedLlmPath_Click"/>
                                    <TextBox x:Name="AdvancedLlmPathBox" Height="{StaticResource FieldHeight}"
                                             Padding="{StaticResource FieldPadding}" VerticalContentAlignment="Center"
                                             Background="{StaticResource FieldBgBrush}"
                                             BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 1: install -->
                    <StackPanel x:Name="InstallPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Wizard.Step.Install}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Wizard.Install.Intro}"/>
                                <TextBlock x:Name="MpvStatusLine" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="AsrStatusLine" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="MtStatusLine" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button x:Name="DownloadAllButton" Content="{loc:Loc Wizard.Install.DownloadAll}"
                                        Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                        Click="DownloadAll_Click"/>
                                <TextBlock x:Name="InstallProgress" Style="{StaticResource Hint}" Margin="0,14,0,0"
                                           MaxHeight="160" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="InstallBlockHint" TextWrapping="Wrap" Margin="0,8,0,0"
                                           FontSize="13" Foreground="{StaticResource DangerBrush}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 2: done -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Wizard.Done.Title}"/>
                                <TextBlock x:Name="DoneSummary" Style="{StaticResource Hint}" LineHeight="22" Margin="0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Wizard.Done.AssociatePlayback}"/>
                                <CheckBox x:Name="AssociatePlaybackBox"
                                          Content="{loc:Loc Wizard.Done.AssociatePlayback}"
                                          Checked="DoneChoiceBox_Changed" Unchecked="DoneChoiceBox_Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Wizard.Done.AssociatePlayback.Hint}"/>
                                <TextBlock x:Name="AssocError" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Wizard.Done.Hint}" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
