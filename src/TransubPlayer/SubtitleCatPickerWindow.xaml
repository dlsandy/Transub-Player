<Window x:Class="TransubPlayer.SubtitleCatPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TransubPlayer.Localization"
        Title="{loc:Loc SubtitleCat.Picker.Title}"
        Width="760" Height="540"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        ContentRendered="Window_ContentRendered">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SkipButton" Content="{loc:Loc SubtitleCat.Picker.Skip}" Click="Skip_Click" Margin="0,0,8,0"/>
            <Button x:Name="UseButton" Style="{StaticResource AccentButton}" Content="{loc:Loc SubtitleCat.Picker.Use}"
                    Click="Use_Click" IsDefault="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{loc:Loc SubtitleCat.Picker.Heading}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="QueryLabel" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{loc:Loc SubtitleCat.Picker.Provider}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                <RadioButton x:Name="ProviderCatRadio" GroupName="OnlineSubProvider"
                             Content="{loc:Loc SubtitleCat.Picker.Provider.Cat}"
                             Margin="0,0,14,0" VerticalAlignment="Center"
                             Checked="Provider_Checked"/>
                <RadioButton x:Name="ProviderXunleiRadio" GroupName="OnlineSubProvider"
                             Content="{loc:Loc SubtitleCat.Picker.Provider.Xunlei}"
                             VerticalAlignment="Center"
                             Checked="Provider_Checked"/>
            </StackPanel>
            <TextBlock x:Name="NoteLabel" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12"
                       Margin="0,0,0,4" Visibility="Collapsed"/>
            <ProgressBar x:Name="SearchProgress" Height="3" Margin="0,0,0,8" IsIndeterminate="True"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="HintLabel" Text="{loc:Loc SubtitleCat.Picker.Hint}" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"/>
            <ListView x:Name="ResultList" Height="300"
                      Background="#111111" Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource {x:Type ListViewItem}}"
                      MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{loc:Loc SubtitleCat.Picker.Col.Source}" Width="90"
                                        DisplayMemberBinding="{Binding Source}"/>
                        <GridViewColumn Header="{loc:Loc SubtitleCat.Picker.Col.Title}" Width="380"
                                        DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="{loc:Loc SubtitleCat.Picker.Col.Downloads}" Width="70"
                                        DisplayMemberBinding="{Binding Downloads}"/>
                        <GridViewColumn Header="{loc:Loc SubtitleCat.Picker.Col.Size}" Width="70"
                                        DisplayMemberBinding="{Binding Size}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyLabel" Text="{loc:Loc SubtitleCat.Picker.Empty}" Visibility="Collapsed"
                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
