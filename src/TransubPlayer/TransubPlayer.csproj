<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TransubPlayer</AssemblyName>
    <RootNamespace>TransubPlayer</RootNamespace>
    <Product>Transub Player</Product>
    <AssemblyTitle>Transub Player</AssemblyTitle>
    <Version>1.6.0</Version>
    <FileVersion>1.6.0</FileVersion>
    <InformationalVersion>1.6.0</InformationalVersion>
    <Authors>Transub</Authors>
    <Description>本地影片边看边出字幕。成片级字幕请用 Transub。</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransubPlayer.Core\TransubPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PresetProbe" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\brand-wordmark.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\app.ico</Link>
    </Content>
  </ItemGroup>

  <!-- Localization XAML packs remain for designer / DynamicResource seed; runtime Loc reads Core embeds. -->
  <ItemGroup>
    <Resource Include="Localization\Strings.*.xaml" Condition="Exists('Localization\Strings.zh-Hans.xaml')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\mpv\**\*" Condition="Exists('..\..\native\mpv\mpv.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>mpv\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.8.1" />
  </ItemGroup>

</Project>
